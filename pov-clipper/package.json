{
  "name": "pov-clipper",
  "version": "0.1.0",
  "description": "Cuts a racer's fastest lap out of their Viewpoint video and uploads it to Blob. Sibling to kart-timing-bridge and vt3-bridge.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
