# Shared with kart-timing-bridge / vt3-bridge. Either name is accepted, so one
# secret can cover all three services (which is how the web side already treats
# them). The daily cron signs its POST with this.
KART_BRIDGE_SECRET=
VT3_BRIDGE_SECRET=

# Where finished clips are reported, e.g.
#   https://fasttraxent.com/api/webhooks/pov-reel-clip
# Leave EMPTY to build clips and publish nothing — a useful dry run.
CLIP_RESULT_WEBHOOK=

# Vercel Blob, read-write. Same token the web app uses; this service only ever
# writes under pov-reel/.
BLOB_READ_WRITE_TOKEN=

# Railway sets this. Local default is 8080.
PORT=8080
