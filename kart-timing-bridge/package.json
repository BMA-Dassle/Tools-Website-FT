{
  "name": "kart-timing-bridge",
  "version": "0.2.0",
  "description": "WebSocket→webhook bridge for FastTrax kart timing broadcasts. Sibling to vt3-bridge.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "probe": "tsx --env-file-if-exists=.env.local src/index.ts --probe",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
